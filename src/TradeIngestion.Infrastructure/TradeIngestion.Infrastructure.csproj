<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TradeIngestion.Application\TradeIngestion.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The SQL artifacts in /Database/Scripts are the single source of truth; they are embedded, not copied. -->
    <EmbeddedResource Include="..\..\Database\Scripts\GetPortfolioSnapshot.sql" Link="Scripts\GetPortfolioSnapshot.sql" LogicalName="TradeIngestion.Scripts.GetPortfolioSnapshot.sql" />
    <EmbeddedResource Include="..\..\Database\Scripts\SeedData.sql" Link="Scripts\SeedData.sql" LogicalName="TradeIngestion.Scripts.SeedData.sql" />
  </ItemGroup>

</Project>
